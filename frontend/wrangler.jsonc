{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "claro-vox",
  "compatibility_date": "2026-10-21",
  // Só assets estáticos: o build do Vite (npm run build) gera ./dist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Exigido pelo `wrangler preview` (deploy de preview das PRs no Workers
  // Builds). Pode ficar vazio: assets e compatibilidade seguem no topo.
  "previews": {}
}
