PORT=4001
DATABASE_URL=postgres://clarovox:clarovox_dev_pw@localhost:5432/claro_vox
# true quando o Postgres é um provedor gerenciado externo (ex.: Supabase) —
# local/docker-compose não precisa disso.
DATABASE_SSL=false
# Local: redis://localhost:6379 — provedor gerenciado com TLS (ex.: Upstash):
# use o esquema rediss:// que eles fornecem, o ioredis liga TLS sozinho.
REDIS_URL=redis://localhost:6379
CPF_HASH_SECRET=troque-este-segredo-em-producao
JWT_SECRET=troque-este-segredo-em-producao
ORCHESTRATOR_URL=http://localhost:4002
